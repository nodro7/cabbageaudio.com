---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Sets the vertical display range of the genTable waveform. <code>min</code> and <code>max</code> define the values shown at the bottom and top of the widget.</p>`;
---
<div class="property-section">
  <Code code={`"range": {"y": {"min": -1, "max": 1}}`} lang="json" />
  <Fragment set:html={description} />
</div>
