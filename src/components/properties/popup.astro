---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Sets whether a slider's popup value box appears while dragging. This is a boolean value. The default varies by widget: <code>numberSlider</code> and <code>xyPad</code> enable it, while the horizontal, vertical, rotary and range sliders disable it.</p>`;
---
<div class="property-section">
  <Code code={`"popup": true`} lang="json" />
  <Fragment set:html={description} />
</div>
