---
import { Code } from '@astrojs/starlight/components';
const description = `<p>A value of <code>true</code> shows the widget; set it to <code>false</code> to hide it (use 0/1 to update from Csound). Widgets are visible by default.</p>`;
---
<div class="property-section">
  <Code code={`"visible": true`} lang="json" />
  <Fragment set:html={description} />
</div>
