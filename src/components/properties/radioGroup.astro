---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Radio group allows buttons and checkboxes to be grouped together so that only one widget in the group can be active at a time. Set to <code>-1</code> for no grouping, or to a positive integer to group widgets together.</p>`;
---
<div class="property-section">
  <Code code={`"radioGroup": -1`} lang="json" />
  <Fragment set:html={description} />
</div>
