---
import { Code } from '@astrojs/starlight/components';
const description = `<ul>
<li>Colors accept named CSS colors, hex (e.g., #RRGGBB or #RRGGBBAA), or rgb/rgba strings.</li>
<li><code>label.text</code> sets the caption; its typography uses <code>style.fontFamily</code>, <code>style.fontSize</code> and <code>style.fontColor</code>.</li>
<li>The background uses <code>style.backgroundColor</code>; the outline uses <code>style.borderColor</code>, <code>style.borderWidth</code> and <code>style.borderRadius</code>.</li>
</ul>`;
---
<div class="property-section">
  <Code code={`"style": {
  "opacity": 1,
  "borderRadius": 4,
  "borderWidth": 1,
  "borderColor": "#dddddd",
  "backgroundColor": "#888888"
},`} lang="json" />
  <Fragment set:html={description} />
</div>
