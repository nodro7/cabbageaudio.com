---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Sets the number of octaves displayed by the keyboard. Set to <code>-1</code> to fit as many octaves as the widget width allows.</p>`;
---
<div class="property-section">
  <Code code={`"octaves": -1`} lang="json" />
  <Fragment set:html={description} />
</div>
