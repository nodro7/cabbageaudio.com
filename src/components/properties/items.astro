---
import { Code } from '@astrojs/starlight/components';
const description = `<p>A list of items for <code>comboBox</code>, <code>listBox</code> or <code>optionButton</code>. Each item has an index: the first selected item sends 0, the second sends 1, the third sends 2, and so on. If <code>items</code> is omitted each widget falls back to its own built-in list: <code>["One", "Two", "Three"]</code> for <code>comboBox</code>, <code>["item1", "item2", "item3"]</code> for <code>listBox</code> and <code>["Item1", "Item2", "Item3"]</code> for <code>optionButton</code>. Set <code>items</code> explicitly rather than relying on these defaults.</p>`;
---
<div class="property-section">
  <Code code={`"items": ["item1", "item2", ...]`} lang="json" />
  <Fragment set:html={description} />
</div>
