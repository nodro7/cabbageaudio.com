---
import { Code } from '@astrojs/starlight/components';
const description = `<p>Holds the child widgets contained by a container widget such as <code>image</code>. Each entry is a widget property object, the same shape as a top-level widget definition.</p>`;
---
<div class="property-section">
  <Code code={`"children": []`} lang="json" />
  <Fragment set:html={description} />
</div>
