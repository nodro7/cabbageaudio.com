---
// Install: three installs and a check, for macOS, Windows and Linux.
//
// All three systems are rendered. A few lines in <head> name the visitor's
// system before the first paint, so the page opens on it and nothing moves;
// the script then lets them switch. Without JavaScript all three are listed
// one after the other. Release data is looked up when the site is built
// (src/lib/release.ts).
import Step from '../components/install/Step.astro';
import Button from '../components/site/Button.astro';
import SegmentedControl from '../components/site/SegmentedControl.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { install, systems } from '../data/install';
import { site } from '../data/site';
import { videos, watchUrl } from '../data/videos';
import { formatDate, formatSize, getRelease } from '../lib/release';

const release = await getRelease();
const releaseDate = formatDate(release.date);
const viaMarketplace = install.marketplaceUrl !== '';
// Windows gets a second download for ARM64 PCs, but only when the current
// release actually ships the file. Older releases and fallback builds have
// no ARM64 package, so the section reads as it always did.
const armAsset = release.source === 'github' ? release.assets['windows-arm'] : null;
---

<SiteLayout
  title="Install Cabbage 3"
  description="Install Csound 7, the Cabbage extension for VS Code and the Csound language extension, then check that they can talk to each other."
  ogImage="/og/install.png"
>
  <Fragment slot="head">
    {/* Sets data-os on <html> for Windows, macOS and Linux. Phones, tablets and anything unknown get all three systems. */}
    <script is:inline>
      (function () {
        var data = navigator.userAgentData;
        var text = ((data && data.platform) || '') + ' ' + (navigator.userAgent || '');
        var os = /Android|iPhone|iPad|iPod|CrOS|Chrome OS/i.test(text)
          ? ''
          : /Win/i.test(text)
            ? 'windows'
            : /Mac/i.test(text)
              ? 'macos'
              : /Linux|X11/i.test(text)
                ? 'linux'
                : '';
        if (os) document.documentElement.dataset.os = os;
      })();
    </script>
  </Fragment>

  <section class="cb-section cb-section--chrome">
    <div class="container install-head">
      <h1 class="cb-title">Install Cabbage 3</h1>
      <p class="cb-lead">
        Three installs, then a quick check that they can talk to each other. You need Visual Studio Code before you
        start.
      </p>
      <div class="install-head__os" data-os-control>
        <SegmentedControl
          label="Operating system"
          size="lg"
          options={systems.map((system) => ({ value: system.id, label: system.label }))}
        />
        <span data-os-hint>Picked from your browser. Change it if we guessed wrong.</span>
      </div>
      <p class="cb-meta">
        Latest release {release.version}{releaseDate && `, ${releaseDate}`}.
        <a href={site.releasesUrl}>All releases on GitHub</a>
      </p>
    </div>
  </section>

  <section class="cb-section">
    <div class="container install-body">
      <div class="install-main">
        {
          systems.map((system) => {
            const asset = release.source === 'github' ? release.assets[system.id] : null;
            const showNote = system.csoundNote && !(system.noteIsAboutSigning && install.installersSigned);
            const noteVideo = videos.find((video) => video.lesson === system.noteLesson);
            return (
              <section class="install-os" data-os={system.id} aria-labelledby={`install-${system.id}`}>
                <h2 class="install-os__title" id={`install-${system.id}`}>
                  {system.label}
                </h2>
                <ol class="install-steps" role="list">
                  <Step number={1} title="Csound 7">
                    <p>
                      Cabbage 3 runs on Csound 7. Download the {system.label} installer from the Csound releases page
                      and run it.
                      {system.id === 'windows' && armAsset && (
                        <>
                          {' '}
                          On an ARM64 PC choose the ARM64 installer: Csound and the extension in step 2 must match.
                        </>
                      )}
                    </p>
                    <Button href={install.csoundReleasesUrl} variant="quiet">
                      Get Csound 7
                    </Button>
                    {showNote && (
                      <div class="install-note">
                        <p>
                          {system.csoundNote}
                          {noteVideo && (
                            <>
                              Lesson {noteVideo.lesson}, <a href={watchUrl(noteVideo)}>{noteVideo.title}</a>, shows the
                              steps.
                            </>
                          )}
                        </p>
                      </div>
                    )}
                  </Step>

                  <Step number={2} title="The Cabbage extension for VS Code">
                    {viaMarketplace ? (
                      <>
                        <p>
                          The editor tools, the live preview and the Cabbage server, in one extension. It installs from
                          the VS Code Marketplace.
                        </p>
                        <Button href={install.marketplaceUrl}>Install from the Marketplace</Button>
                        <details class="install-vsix">
                          <summary>Install from a VSIX file instead</summary>
                          <p>
                            <a href={asset?.url ?? site.releasesUrl}>Download the {system.label} VSIX</a>
                            {asset && `(${asset.name}, ${formatSize(asset.size)})`}. In VS Code, open the command
                            palette ({system.paletteKey}), run Extensions: Install from VSIX and choose the file you
                            downloaded.
                          </p>
                        </details>
                      </>
                    ) : (
                      <>
                        <p>
                          The editor tools, the live preview and the Cabbage server, in one file. Download it, then
                          install it from inside VS Code.
                        </p>
                        {system.id === 'windows' && armAsset ? (
                          /* Two Windows packages. x64 is the safe default: it also installs on an
                             ARM64 PC, the reverse does not. When the browser reports ARM64 (Chromium
                             only, see src/scripts/install.js) the ARM64 download goes first and takes
                             the green. */
                          <div class="install-downloads" data-arch-control>
                            <div class="install-download" data-arch="x64">
                              <Button href={asset?.url ?? site.releasesUrl}>Download for Windows (x64)</Button>
                              {asset && (
                                <span class="install-download__file">
                                  {asset.name}, {formatSize(asset.size)}
                                </span>
                              )}
                            </div>
                            <div class="install-download" data-arch="arm64">
                              <Button href={armAsset.url} variant="quiet">
                                Download for Windows (ARM64)
                              </Button>
                              <span class="install-download__file">
                                {armAsset.name}, {formatSize(armAsset.size)}
                              </span>
                            </div>
                            <p class="install-downloads__hint" data-arch-hint>
                              Most PCs are x64. ARM64 is for Snapdragon laptops and Copilot+ PCs: check Settings,
                              System, About, under System type.
                            </p>
                          </div>
                        ) : (
                          <div class="install-download">
                            <Button href={asset?.url ?? site.releasesUrl}>Download for {system.label}</Button>
                            {asset && (
                              <span class="install-download__file">
                                {asset.name}, {formatSize(asset.size)}
                              </span>
                            )}
                          </div>
                        )}
                        <p>
                          In VS Code, open the command palette ({system.paletteKey}), run Extensions: Install from VSIX
                          and choose the file you downloaded.
                        </p>
                      </>
                    )}
                  </Step>

                  <Step number={3} title="The Csound language extension">
                    <p>
                      Syntax highlighting, opcode hints and error checking for your Csound code. It installs from the
                      VS Code Marketplace.
                    </p>
                    <Button href={install.languageExtensionUrl} variant="quiet">
                      Open in the Marketplace
                    </Button>
                  </Step>

                  <Step title="Make a sound" last>
                    <ol class="install-check">
                      <li>Click {install.statusBarLabel} in the VS Code status bar to start the Cabbage server.</li>
                      <li>
                        Open the command palette ({system.paletteKey}) and run Create Synth File (Cabbage UI).
                      </li>
                      <li>Save the file. The instrument opens in a panel beside your code, ready to play.</li>
                    </ol>
                    <p>
                      Nothing on screen? Run Cabbage: Validate Installation from the command palette, or see the
                      <a href="/docs/faqs/">FAQs</a>.
                    </p>
                  </Step>
                </ol>
              </section>
            );
          })
        }
      </div>

      <aside class="install-aside">
        <div class="install-box">
          <h2>Stuck?</h2>
          <p>The FAQs cover the usual suspects, and the forum is quick to answer the rest.</p>
          <div class="install-box__links">
            <a class="textlink" href="/docs/faqs/">Read the FAQs</a>
            <a class="textlink" href={site.forumUrl}>Ask on the forum</a>
          </div>
        </div>
        <div class="install-box">
          <h2>Looking for Cabbage 2?</h2>
          <p>Cabbage 2 downloads and docs have moved to their own site.</p>
          <a class="textlink" href={site.v2Url}>v2.cabbageaudio.com</a>
        </div>
      </aside>
    </div>
  </section>
</SiteLayout>

<script>
  import '../scripts/install.js';
</script>

<style>
  .install-head {
    padding-block: clamp(40px, 5vw, 64px) clamp(32px, 4vw, 48px);
  }
  .install-head .cb-lead {
    max-width: 640px;
    margin-top: 16px;
  }
  .install-head__os {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 28px;
    font-size: var(--cb-text-small);
    color: var(--cb-muted);
  }
  /* The switch needs the script. */
  :global(html:not(.js)) .install-head__os {
    display: none;
  }
  .install-head .cb-meta {
    margin-top: 16px;
  }

  .install-body {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 48px 64px;
    padding-block: clamp(40px, 5vw, 64px) clamp(56px, 7vw, 96px);
  }
  .install-main {
    display: flex;
    flex: 1 1 560px;
    flex-direction: column;
    gap: 56px;
    min-width: 0;
    max-width: 760px;
  }

  /* One system is chosen: data-os on <html> names it and the other two are
     not shown. */
  :global(html[data-os='macos']) .install-os:not([data-os='macos']),
  :global(html[data-os='windows']) .install-os:not([data-os='windows']),
  :global(html[data-os='linux']) .install-os:not([data-os='linux']) {
    display: none;
  }

  /* Each system's heading is shown when all three are listed (no JavaScript,
     or a system we could not detect). Once one is chosen, the control names
     it, so the heading is kept for screen readers only. */
  .install-os__title {
    margin-bottom: 24px;
    font-size: var(--cb-text-h3-lg);
    line-height: 1.15;
    font-weight: 600;
    font-stretch: 88%;
  }
  :global(html[data-os]) .install-os__title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .install-steps {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .install-steps :global(.cb-step__body > p) {
    margin-top: 8px;
    color: var(--cb-muted);
  }
  .install-steps :global(.cb-step__body > .btn) {
    margin-top: 16px;
  }
  .install-steps :global(.cb-step__body > .install-download + p),
  .install-steps :global(.cb-step__body > .install-downloads + p) {
    margin-top: 16px;
  }

  .install-note {
    margin-top: 16px;
    padding: 16px 18px;
    border: 1px solid var(--cb-line);
    border-radius: 10px;
    background: var(--cb-chrome);
    font-size: var(--cb-text-body-sm);
    color: var(--cb-muted);
  }

  .install-download {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin-top: 16px;
  }
  .install-download__file {
    font-family: var(--cb-font-mono);
    font-size: var(--cb-text-code);
    color: var(--cb-muted);
    overflow-wrap: anywhere;
  }

  /* Two Windows downloads, x64 first unless the browser says ARM64. */
  .install-downloads {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 16px;
  }
  .install-downloads .install-download {
    margin-top: 0;
  }
  .install-downloads__hint {
    font-size: var(--cb-text-small);
    color: var(--cb-muted);
  }
  :global(html[data-arch='arm64']) .install-download[data-arch='arm64'] {
    order: -1;
  }

  .install-vsix {
    margin-top: 16px;
    color: var(--cb-muted);
  }
  .install-vsix summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--cb-target);
    cursor: pointer;
    font-weight: 500;
    color: var(--cb-blue);
  }

  .install-check {
    margin: 10px 0 0;
    padding-left: 22px;
    color: var(--cb-muted);
  }
  .install-check li {
    padding: 3px 0;
  }
  .install-steps :global(.cb-step__body > .install-check + p) {
    margin-top: 12px;
  }

  .install-aside {
    display: flex;
    flex: 1 1 280px;
    flex-direction: column;
    gap: 16px;
    max-width: 360px;
  }
  .install-box {
    padding: 20px 22px 12px;
    border: 1px solid var(--cb-line);
    border-radius: var(--cb-radius-lg);
    background: var(--cb-chrome);
  }
  .install-box h2 {
    font-size: var(--cb-text-lead);
    line-height: 1.3;
    font-weight: 600;
  }
  .install-box p {
    margin-top: 6px;
    font-size: var(--cb-text-body-sm);
    color: var(--cb-muted);
  }
  .install-box__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
  }
</style>
